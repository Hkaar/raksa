# Salin ke .env lalu isi. Jangan pernah commit .env.
# Origin frontend yang diizinkan (array JSON).
RAKSA_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

RAKSA_GEMINI_API_KEY=
RAKSA_GEMINI_MODEL=gemini-3.5-flash-lite
RAKSA_GEMINI_TIMEOUT_SECONDS=45

# Login petugas (Supabase Auth). username dipetakan ke username@RAKSA_OFFICER_EMAIL_DOMAIN.
RAKSA_SUPABASE_URL=
RAKSA_SUPABASE_PUBLISHABLE_KEY=
RAKSA_OFFICER_EMAIL_DOMAIN=

# Shortcut "Masuk sebagai demo". Aktifkan hanya pada proyek Supabase demo terpisah.
RAKSA_OFFICER_SHORTCUT_ENABLED=false
RAKSA_OFFICER_SHORTCUT_EMAIL=
RAKSA_OFFICER_SHORTCUT_PASSWORD=

# Hanya untuk scripts/seed.py dan scripts/seed_officer.py (tanpa prefix RAKSA_).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_OFFICER_ID=
SUPABASE_OFFICER_NAME=
SUPABASE_OFFICER_ORGANIZATION=
SUPABASE_OFFICER_PHONE=
